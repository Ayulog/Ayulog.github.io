---
import { getRelativeLocaleUrl } from "astro:i18n";
import { setupCategories, type SetupCategorySlug } from "@/data/setup";
import config from "@/config";

type Props = { current?: SetupCategorySlug };
const { current } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
---

<nav aria-label="折腾分类" class="my-8">
  <ul class="flex flex-wrap gap-x-6 gap-y-2">
    {
      setupCategories.map(category => (
        <li>
          <a
            href={getRelativeLocaleUrl(locale, `setup/${category.slug}`)}
            class:list={[
              "hover:text-accent inline-block py-2 text-sm",
              { "active-nav text-accent": current === category.slug },
            ]}
            aria-current={current === category.slug ? "page" : undefined}
          >
            {category.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
