---
import IconArrowLeft from "@/assets/icons/IconArrowLeft.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

type AdjacentPost = {
  id: string;
  title: string;
  filePath: string | undefined;
  categoryLabel?: string;
} | null;

type Props = {
  prevPost: AdjacentPost;
  nextPost: AdjacentPost;
};

const { prevPost, nextPost } = Astro.props;
const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
---

<nav
  aria-label="上下篇导航"
  data-pagefind-ignore
  class="my-8 grid grid-cols-1 gap-4 sm:grid-cols-2"
>
  {
    prevPost && (
      <a
        href={getPostUrl(prevPost.id, prevPost.filePath, locale)}
        class="border-border/70 hover:border-accent/60 bg-muted/15 flex w-full items-start gap-2.5 rounded-lg border p-4 transition-colors"
      >
        <IconArrowLeft class="text-muted-foreground mt-0.5 inline-block flex-none rtl:rotate-180" />
        <div class="min-w-0">
          <div class="text-muted-foreground text-xs">
            {t.post.previousPost}
            {prevPost.categoryLabel ? ` · ${prevPost.categoryLabel}` : ""}
          </div>
          <div class="text-accent mt-1 text-sm leading-6 font-medium">
            {prevPost.title}
          </div>
        </div>
      </a>
    )
  }
  {
    nextPost && (
      <a
        href={getPostUrl(nextPost.id, nextPost.filePath, locale)}
        class="border-border/70 hover:border-accent/60 bg-muted/15 flex w-full items-start justify-end gap-2.5 rounded-lg border p-4 text-end transition-colors sm:col-start-2"
      >
        <div class="min-w-0">
          <div class="text-muted-foreground text-xs">
            {nextPost.categoryLabel ? `${nextPost.categoryLabel} · ` : ""}
            {t.post.nextPost}
          </div>
          <div class="text-accent mt-1 text-sm leading-6 font-medium">
            {nextPost.title}
          </div>
        </div>
        <IconArrowRight class="text-muted-foreground mt-0.5 inline-block flex-none rtl:rotate-180" />
      </a>
    )
  }
</nav>
