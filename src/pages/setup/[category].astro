---
import type { GetStaticPaths } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import CategoryPage from "@/components/CategoryPage.astro";
import {
  categories,
  legacyCategoryRedirects,
  getSection,
  type Category,
} from "@/data/categories";
import config from "@/config";

const section = getSection("setup");
if (!section) {
  throw new Error("Missing setup section");
}

export const getStaticPaths = (() => [
  ...categories
    .filter(category => category.section === "setup")
    .map(category => ({
      params: { category: category.slug },
      props: { category },
    })),
  ...legacyCategoryRedirects.map(entry => ({
    params: { category: entry.from },
    props: { redirectTo: `setup/${entry.to}` },
  })),
]) satisfies GetStaticPaths;

type Props = { category: Category } | { redirectTo: string };

const locale = Astro.currentLocale ?? config.site.lang;

if ("redirectTo" in Astro.props) {
  return Astro.redirect(
    getRelativeLocaleUrl(locale, Astro.props.redirectTo),
    301
  );
}
---

<CategoryPage section={section} category={Astro.props.category} />
