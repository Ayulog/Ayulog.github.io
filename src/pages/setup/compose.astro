---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { composeEntries } from "@/data/compose";
import { composeArchive } from "@/data/setup";
import { getAssetPath } from "@/utils/withBase";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
function getGuideUrl(path: string) {
  const [pathname, fragment] = path.split("#");
  const url = getRelativeLocaleUrl(locale, pathname.replace(/^\//, ""));
  return fragment ? `${url}#${fragment}` : url;
}

const groups = [
  { id: "media", label: "媒体与下载" },
  { id: "management", label: "管理与存储" },
  { id: "network", label: "网络与远程" },
];
---

<Layout
  title={`${composeArchive.label} · 折腾 | ${config.site.title}`}
  description={composeArchive.description}
>
  <Header />

  <nav class="app-layout mt-8 mb-1" aria-label="面包屑导航">
    <ol class="text-muted-foreground flex flex-wrap items-center gap-x-2">
      <li>
        <a href={getRelativeLocaleUrl(locale, "")} class="hover:text-accent">
          首页
        </a>
      </li>
      <li aria-hidden="true">&raquo;</li>
      <li>
        <a
          href={getRelativeLocaleUrl(locale, "setup")}
          class="hover:text-accent"
        >
          折腾
        </a>
      </li>
      <li aria-hidden="true">&raquo;</li>
      <li aria-current="page">{composeArchive.label}</li>
    </ol>
  </nav>

  <Main pageTitle={composeArchive.label} pageDesc={composeArchive.description}>
    <section
      aria-label="下载与使用"
      class="border-border rounded-lg border p-5"
    >
      <p class="leading-7">
        把文章里用到的 {composeEntries.length} 套 Compose 集中放在这里，方便查找和下载。
        每套示例独立使用，部署前填写自己的目录、账号与密钥，并检查端口是否冲突。
      </p>
      <div class="mt-4 flex flex-wrap items-center gap-x-6 gap-y-3">
        <a
          href={getAssetPath("examples/debnas-compose.zip")}
          download="debnas-compose.zip"
          class="bg-accent text-accent-foreground inline-block rounded px-4 py-2 font-medium hover:underline"
        >
          下载全部示例（ZIP）
        </a>
        <a
          href={getAssetPath("examples/debnas/README.md")}
          download="README.md"
          class="text-accent underline decoration-dashed underline-offset-4"
        >
          下载使用说明
        </a>
      </div>
      <p class="text-muted-foreground mt-4 text-sm leading-6">
        需要 env.example 的服务，请下载后另存为 .env 并填写；Mihomo
        还需要应用配置模板。 具体步骤见各项的配套教程。
      </p>
    </section>

    <nav aria-label="存档分组" class="my-8">
      <ul class="flex flex-wrap gap-x-6 gap-y-3">
        {
          groups.map(group => (
            <li>
              <a
                href={`#${group.id}`}
                class="text-accent underline decoration-dashed underline-offset-4"
              >
                {group.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="space-y-10">
      {
        groups.map(group => (
          <section aria-labelledby={group.id}>
            <h2 id={group.id} class="text-xl font-semibold sm:text-2xl">
              {group.label}
            </h2>
            <ul class="divide-border divide-y">
              {composeEntries
                .filter(entry => entry.group === group.label)
                .map(entry => (
                  <li id={entry.slug} class="py-6">
                    <h3 class="text-lg font-medium">{entry.name}</h3>
                    <p class="text-muted-foreground mt-2 leading-7">
                      {entry.description}
                    </p>
                    <ul
                      aria-label={`${entry.name} 配置下载`}
                      class="mt-3 flex flex-wrap gap-x-5 gap-y-2"
                    >
                      {entry.files.map(file => (
                        <li>
                          <a
                            href={getAssetPath(file.path)}
                            download={file.name}
                            aria-label={`${entry.name}：下载 ${file.name}`}
                            class="text-accent inline-block py-1 text-sm underline decoration-dashed underline-offset-4"
                          >
                            下载 {file.name}
                          </a>
                        </li>
                      ))}
                    </ul>
                    <a
                      href={getGuideUrl(entry.guide.path)}
                      class="text-accent mt-2 inline-block py-1 text-sm hover:underline"
                    >
                      配套教程：{entry.guide.label} &rarr;
                    </a>
                  </li>
                ))}
            </ul>
          </section>
        ))
      }
    </div>
  </Main>

  <Footer />
</Layout>
