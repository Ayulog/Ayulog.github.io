---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { setupCategories } from "@/data/setup";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const description = "记录系统安装、设备配置与日常维护。";
---

<Layout title={`装机 | ${config.site.title}`} {description}>
  <Header />

  <nav class="app-layout mt-8 mb-1" aria-label="面包屑导航">
    <ol class="text-muted-foreground flex flex-wrap items-center gap-x-2">
      <li>
        <a href={getRelativeLocaleUrl(locale, "")} class="hover:text-accent">
          首页
        </a>
      </li>
      <li aria-hidden="true">&raquo;</li>
      <li aria-current="page">装机</li>
    </ol>
  </nav>

  <Main pageTitle="装机" pageDesc={description}>
    <ul class="grid gap-4 sm:grid-cols-2">
      {
        setupCategories.map(category => (
          <li>
            <a
              href={getRelativeLocaleUrl(locale, `setup/${category.slug}`)}
              class="group block h-full py-5 transition-colors"
            >
              <h2 class="text-accent flex items-center justify-between text-xl font-semibold">
                <span class="group-hover:active-nav">{category.label}</span>
                <IconArrowRight aria-hidden="true" class="size-5" />
              </h2>
              <p class="text-muted-foreground mt-3">{category.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </Main>

  <Footer />
</Layout>
