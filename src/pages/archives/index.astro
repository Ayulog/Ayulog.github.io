---
import { getRelativeLocaleUrl } from "astro:i18n";
import { getCollection } from "astro:content";
import dayjs from "dayjs";
import utc from "dayjs/plugin/utc";
import timezone from "dayjs/plugin/timezone";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getCategory } from "@/data/categories";
import { getPostUrl } from "@/utils/getPostPaths";
import { postFilter } from "@/utils/postFilter";
import { getPostsByGroupCondition } from "./_utils/getPostsByGroupCondition";
import { useTranslations } from "@/i18n";
import config from "@/config";

dayjs.extend(utc);
dayjs.extend(timezone);

const locale = Astro.currentLocale ?? config.site.lang;

// Redirect to 404 page if `showArchives` config is false
const notFoundUrl = getRelativeLocaleUrl(locale, "404");
if (!config.features.showArchives && notFoundUrl) {
  return Astro.rewrite(notFoundUrl);
}

const t = useTranslations(locale);

const posts = await getCollection("posts");
const filteredPosts = posts.filter(postFilter);
const monthFormatter = new Intl.DateTimeFormat(locale, { month: "long" });
const formatDay = (date: Date, tz?: string) =>
  dayjs(date)
    .tz(tz ?? config.site.timezone)
    .format("MM-DD");
---

<Layout title={`${t.pages.archivesTitle} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main pageTitle={t.pages.archivesTitle}>
    {
      Object.entries(
        getPostsByGroupCondition(filteredPosts, post =>
          post.data.pubDatetime.getFullYear()
        )
      )
        .sort(([yearA], [yearB]) => Number(yearB) - Number(yearA))
        .map(([year, yearGroup]) => (
          <section class="mb-10">
            <div class="border-border/70 mb-4 flex items-baseline gap-2 border-b pb-2">
              <h2 class="font-mono text-2xl font-bold">{year}</h2>
              <span class="text-muted-foreground font-mono text-sm">
                ({yearGroup.length})
              </span>
            </div>
            {Object.entries(
              getPostsByGroupCondition(
                yearGroup,
                post => post.data.pubDatetime.getMonth() + 1
              )
            )
              .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
              .map(([month, monthGroup]) => (
                <div class="my-5 flex flex-col sm:flex-row sm:items-baseline">
                  <div class="mb-2 min-w-28 text-base sm:mb-0">
                    <span class="font-semibold">
                      {monthFormatter.format(
                        new Date(2000, Number(month) - 1, 1)
                      )}
                    </span>
                    <sup class="text-muted-foreground ms-1 font-mono text-xs">
                      {monthGroup.length}
                    </sup>
                  </div>
                  <ul class="flex-1 space-y-2.5">
                    {monthGroup
                      .sort(
                        (a, b) =>
                          Math.floor(
                            new Date(b.data.pubDatetime).getTime() / 1000
                          ) -
                          Math.floor(
                            new Date(a.data.pubDatetime).getTime() / 1000
                          )
                      )
                      .map(post => {
                        const cat = getCategory(post.data.category);
                        return (
                          <li class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                            <time
                              class="text-muted-foreground shrink-0 font-mono text-sm"
                              datetime={post.data.pubDatetime.toISOString()}
                            >
                              {formatDay(
                                post.data.pubDatetime,
                                post.data.timezone
                              )}
                            </time>
                            <a
                              href={getPostUrl(post.id, post.filePath, locale)}
                              class="text-foreground hover:text-accent font-medium decoration-dashed underline-offset-4 hover:underline"
                            >
                              {post.data.title}
                            </a>
                            {cat && (
                              <span class="text-muted-foreground text-xs">
                                · {cat.label}
                              </span>
                            )}
                          </li>
                        );
                      })}
                  </ul>
                </div>
              ))}
          </section>
        ))
    }
  </Main>

  <Footer />
</Layout>
