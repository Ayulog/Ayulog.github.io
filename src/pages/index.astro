---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import LinkButton from "@/components/LinkButton.astro";
import { sections } from "@/data/categories";
import { postFilter } from "@/utils/postFilter";
import { getPostUrl } from "@/utils/getPostPaths";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials, posts: postsConfig } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const posts = (await getCollection("posts"))
  .filter(postFilter)
  .sort(
    (a, b) =>
      new Date(b.data.pubDatetime).getTime() -
      new Date(a.data.pubDatetime).getTime()
  );
const recentPosts = posts.slice(0, postsConfig.perIndex);
const sectionEntries = sections.map(section => {
  const entries = posts.filter(
    post =>
      post.data.category && section.categories.includes(post.data.category)
  );
  return {
    ...section,
    count: entries.length,
    latest: entries.slice(0, 2),
  };
});
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-8">
      <div
        class="flex flex-col gap-8 sm:flex-row sm:items-center sm:justify-between"
      >
        <div class="min-w-0 flex-1">
          <div class="flex items-center gap-3">
            <h1
              class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl"
            >
              Ayulog
            </h1>
            <a
              target="_blank"
              href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
              class="inline-block"
              aria-label="RSS Feed"
              title="RSS Feed"
            >
              <IconRss
                width={20}
                height={20}
                class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
              />
              <span class="sr-only">RSS Feed</span>
            </a>
          </div>

          <p class="max-w-xl text-lg leading-8">
            记录生活、技术、游戏，以及一些慢慢积累的小事。
          </p>
          <p class="text-muted-foreground mt-2">教程为主，偶尔写点别的。</p>
          {
            socials.length > 0 && (
              <div class="mt-5 flex max-sm:flex-col sm:items-center">
                <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
                  {t.home.socialLinks}:
                </div>
                <Socials />
              </div>
            )
          }
        </div>

        <div class="shrink-0 self-center sm:self-auto">
          <div
            class="border-border bg-muted/40 flex h-32 w-32 items-center justify-center overflow-hidden rounded-full border p-3 shadow-sm sm:h-40 sm:w-40"
          >
            <img
              src={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}avatar.png?v=2`}
              alt="Ayulog 像素小鸡头像"
              width="160"
              height="160"
              class="block h-full w-full object-contain"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>
      </div>
    </section>

    <section
      id="sections"
      aria-labelledby="sections-title"
      class="border-border border-b pt-10 pb-8"
    >
      <h2 id="sections-title" class="text-2xl font-semibold tracking-wide">
        板块
      </h2>
      <div class="mt-6 grid gap-x-8 gap-y-8 sm:grid-cols-3">
        {
          sectionEntries.map(section => (
            <div>
              <h3 class="text-lg font-semibold">
                <a
                  href={getRelativeLocaleUrl(locale, section.slug)}
                  class="text-accent hover:underline"
                >
                  {section.label}
                </a>
                <span class="text-muted-foreground ms-2 text-sm font-normal">
                  {section.count}
                </span>
              </h3>
              <p class="text-muted-foreground mt-2 text-sm leading-6">
                {section.description}
              </p>
              {section.latest.length > 0 ? (
                <ul class="mt-3 space-y-1.5">
                  {section.latest.map(post => (
                    <li>
                      <a
                        href={getPostUrl(post.id, post.filePath, locale)}
                        class="hover:text-accent text-sm leading-6 hover:underline"
                      >
                        {post.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-muted-foreground mt-3 text-sm">还没有文章。</p>
              )}
            </div>
          ))
        }
      </div>
    </section>

    {
      recentPosts.length > 0 && (
        <section id="recent-posts" class="pt-10 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">
            {t.home.recentPosts}
          </h2>
          <ul>
            {recentPosts.map(data => (
              <Card variant="h3" {...data} />
            ))}
          </ul>
        </section>
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
