---
import type { GetStaticPaths } from "astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import CategoryPage from "@/components/CategoryPage.astro";
import { categories, getSection, type Category } from "@/data/categories";
import config from "@/config";

const section = getSection("media");
if (!section) {
  throw new Error("Missing media section");
}

export const getStaticPaths = (() => [
  ...categories
    .filter(category => category.section === "media")
    .map(category => ({
      params: { category: category.slug },
      props: { category },
    })),
  {
    params: { category: "other" },
    props: { redirectTo: "media" },
  },
]) satisfies GetStaticPaths;

type Props = { category: Category } | { redirectTo: string };

const locale = Astro.currentLocale ?? config.site.lang;

if ("redirectTo" in Astro.props) {
  return Astro.redirect(
    getRelativeLocaleUrl(locale, Astro.props.redirectTo),
    301
  );
}
---

<CategoryPage section={section} category={Astro.props.category} />
