---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { mediaCategories } from "@/data/media";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { getPostUrl } from "@/utils/getPostPaths";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const description = "字幕、音频、DIY 与压制的软件和资料，具体操作另写教程。";
const posts = getSortedPosts(await getCollection("posts"));
const categories = mediaCategories.map(category => {
  const articles = posts.filter(
    post => post.data.mediaCategory === category.slug
  );
  return {
    ...category,
    overview: articles.find(post => post.data.mediaRole === "overview"),
    guides: articles.filter(post => post.data.mediaRole !== "overview"),
  };
});
---

<Layout title={`Media | ${config.site.title}`} {description}>
  <Header />
  <nav class="app-layout mt-8 mb-1" aria-label="面包屑导航">
    <ol class="text-muted-foreground flex flex-wrap items-center gap-x-2">
      <li>
        <a href={getRelativeLocaleUrl(locale, "")} class="hover:text-accent"
          >首页</a
        >
      </li>
      <li aria-hidden="true">&raquo;</li>
      <li aria-current="page">Media</li>
    </ol>
  </nav>
  <Main pageTitle="Media" pageDesc={description}>
    <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2">
      {
        categories.map(category => (
          <section aria-labelledby={`category-${category.slug}`}>
            <h2 id={`category-${category.slug}`} class="text-xl font-semibold">
              <a
                href={getRelativeLocaleUrl(locale, `media/${category.slug}`)}
                class="text-accent flex items-center justify-between gap-3 hover:underline"
              >
                {category.label}
                <IconArrowRight aria-hidden="true" class="size-5 shrink-0" />
              </a>
            </h2>
            <p class="text-muted-foreground mt-2 text-sm leading-6">
              {category.description}
            </p>
            {category.overview && (
              <div class="border-border mt-4 border-s-2 ps-4">
                <p class="text-muted-foreground text-xs">总篇</p>
                <a
                  href={getPostUrl(
                    category.overview.id,
                    category.overview.filePath,
                    locale
                  )}
                  class="text-accent mt-1 inline-block font-medium hover:underline"
                >
                  常用软件与资料
                </a>
              </div>
            )}
            {category.guides.length > 0 ? (
              <>
                <p class="text-muted-foreground mt-5 text-xs">
                  教程与笔记 · {category.guides.length} 篇
                </p>
                <ul class="mt-2 space-y-2">
                  {category.guides.slice(0, 4).map(post => (
                    <li>
                      <a
                        href={getPostUrl(post.id, post.filePath, locale)}
                        class="hover:text-accent text-sm leading-6 hover:underline"
                      >
                        {post.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
                <a
                  href={getRelativeLocaleUrl(locale, `media/${category.slug}`)}
                  class="text-accent mt-4 inline-block text-sm hover:underline"
                >
                  查看全部 &rarr;
                </a>
              </>
            ) : (
              <p class="text-muted-foreground mt-5 text-sm">
                教程与笔记陆续补充。
              </p>
            )}
          </section>
        ))
      }
    </div>
  </Main>
  <Footer />
</Layout>
